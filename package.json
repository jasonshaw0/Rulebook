{
  "name": "rulebook-agent-rule-manager",
  "displayName": "Rulebook - Agent Rule Manager",
  "description": "Cursor-only extension for managing project rules and presets.",
  "version": "0.0.4",
  "publisher": "jasonshaw0",
  "icon": "media/rulebook-logo-nobg-blue.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonshaw0/Rulebook"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:agentRulesView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentRules",
          "title": "Rulebook - Agent Rule Manager",
          "icon": "media/rulebook-icon.svg"
        }
      ]
    },
    "views": {
      "agentRules": [
        {
          "id": "agentRulesView",
          "name": "Rulebook - Agent Rule Manager",
          "type": "webview"
        }
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.5.4"
  }
}